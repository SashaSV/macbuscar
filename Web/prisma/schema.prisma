// =============================================================
// macbuscar / Manzana.es — Database Schema v2
// =============================================================
// Hierarchy:
//   Product  (family, e.g. "iPhone 17 Pro Max")
//     └─ ProductVariant  (SKU, e.g. "iPhone 17 Pro Max 256GB Negro")
//          └─ Price (Variant × Store)
//          └─ PriceHistory
//          └─ ScrapedProduct
//          └─ Listing (2ª mano)
//
// Monetization: anonymous affiliate links via Store + Click logging.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ CANONICAL CATALOG ============

/// Product = canonical family of models (one "Comprar" button on apple.com)
/// e.g. "iPhone 17 Pro Max", "MacBook Air 13 M5"
model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  nombre      String
  cat         String                            // "iphone" | "mac" | "ipad" | "watch" | "airpods" | "tv" | "accesorios"
  family      String                            // "iPhone 17 Pro" | "MacBook Air" — groups Pro+Pro Max together in UI
  emoji       String    @default("📦")
  rating      Float     @default(0)
  tag         String    @default("")            // "Novedad" | "Oferta" | "Pro" | ""
  desc        String    @default("")

  fotos       String    @default("[]")          // full gallery as JSON array
  fotoLabels  String    @default("[]")
  specs       String    @default("{}")

  // Card images — picked deterministically from the gallery for grid cards.
  // cover = main thumbnail shown on the card.
  // hover = second image shown on mouse-hover (different angle / back view).
  cover       String?
  hover       String?

  basePrice   Float?                             // lowest variant price (denormalized)
  releasedAt  String?                             // "2025-09"

  // View counter — incremented on each modal open via
  // POST /api/products/[id]/view. Drives the "Más populares" listing
  // on the home page. We index it for fast ORDER BY views DESC LIMIT N
  // even though the catalog is small today; cheap insurance.
  views       Int       @default(0)

  matchKeys   String    @default("[]")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants    ProductVariant[]
  reviews     Review[]

  @@index([cat])
  @@index([family])
  @@index([views])
}

/// ProductVariant = one specific SKU
/// e.g. "iPhone 17 Pro Max 256GB Negro Titanio"
model ProductVariant {
  id          Int       @id @default(autoincrement())
  productId   Int

  nombre      String                            // display name
  sku         String?   @unique
  ean         String?   @unique

  // Specifications (filterable in UI)
  memory      String?                           // "256GB" — storage
  ram         String?                           // "24GB" — Mac RAM (separate from storage)
  color       String?                           // "Negro Titanio"
  colorHex    String?                           // "#1d1d1f"
  display     String?                           // "6.9 pulgadas"
  cpu         String?                           // "M5 Pro" | "A18 Pro"
  cpuCores    String?                           // "10" | "14" | "18" — Mac CPU cores
  gpu         String?                           // "10-core GPU"
  gpuCores    String?                           // "10" | "20" | "32" | "40" — Mac GPU cores
  screen      String?                           // "Standard" | "Nano-texture" — Mac/iPad glass
  connectivity String?                          // "Wi-Fi" | "Wi-Fi + Cellular"
  bandSize    String?                           // "45mm" | "49mm"
  fotos       Json     @default("[]")           // full variant gallery
  // Card images for this specific SKU (variant-page cards / color-picker etc.)
  cover       String?
  hover       String?
  msrp        Float?                            // Apple official price
  matchKeys   String    @default("[]")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices        Price[]
  priceHistory  PriceHistory[]
  scrapedItems  ScrapedProduct[]
  listings      Listing[]
  clicks        Click[]

  @@index([productId])
  @@index([memory])
  @@index([color])
}

// ============ STORES ============

model Store {
  id          String   @id
  nombre      String
  logo        String
  url         String
  badge       String   @default("")

  // Geography
  country     String   @default("ES")           // "ES" | "DE" | "IT" | "FR"
  language    String   @default("es")
  currency    String   @default("EUR")

  // Shipping to Spain
  shippingToES        Float?
  shippingDays        Int?
  freeShippingFrom    Float?

  // Affiliate / Monetization
  affiliateProvider  String?                    // "awin" | "amazon" | "tradedoubler" | "cj" | "direct"
  affiliateId        String?                    // your partner ID
  affiliateTemplate  String?                    // URL template with {url} and {affId}
  commissionPct      Float?                     // % we receive (analytics)

  // Scraper
  delay       Int      @default(1000)
  enabled     Boolean  @default(true)
  scraperType String   @default("selenium")     // "selenium" | "api" | "manual"

  // Trust (future)
  rating      Float?
  reviewCount Int?

  // Apple authorization tier — drives the trust badge shown next to the
  // store name in the Precios tab. Higher tier = stronger "genuine Apple
  // product, full warranty" cue for the buyer. Source of truth is Apple's
  // own retailer locator at https://locate.apple.com.
  //   "official"   → Apple themselves (apple.com). Card lives in Zone 1
  //                  as the anchor; no badge needed (Apple == Apple).
  //   "premium"    → Apple Premium Reseller. The top reseller tier: physical
  //                  Apple-style stores, full warranty / AppleCare, dedicated
  //                  Genius-style support. K-tuin, PcComponentes, iStore,
  //                  Rossellimac in Spain.
  //   "authorized" → Authorized Reseller. Standard tier: genuine SKUs, full
  //                  Apple warranty applies, but no Premium store experience.
  //                  MediaMarkt, El Corte Inglés, Fnac in Spain.
  //   "mixed"      → Marketplace where SOME SKUs are authorized and others
  //                  aren't (Amazon: "Vendido por Amazon" SKUs are
  //                  authorized; third-party seller listings are not).
  //                  UI surfaces a softer "Verifica vendedor" cue.
  //   null         → Not on Apple's authorized list. Worten in Spain ships
  //                  genuine product but isn't formally authorized; we just
  //                  omit the badge rather than shaming them.
  appleAuthLevel  String?

  createdAt   DateTime @default(now())

  prices       Price[]
  priceHistory PriceHistory[]
  scrapedItems ScrapedProduct[]
  clicks       Click[]

  @@index([country])
}

// ============ PRICES ============

/// Current price for a Variant at a Store
model Price {
  id          Int       @id @default(autoincrement())
  variantId   Int
  storeId     String

  price       Float
  oldPrice    Float?
  url         String?

  stock       String   @default("unknown")     // "in_stock" | "out_of_stock" | "preorder" | "unknown"
  shipping    Float?
  discountPct Float?                            // computed from oldPrice
  condition   String   @default("new")          // "new" | "open_box" | "refurbished"

  // ── Financing (Spain market — Apple gear €1000+ is often bought on monthly plans)
  // All are NULL when the store doesn't expose financing info for this SKU.
  // monthlyApr == 0.0 means "Sin Intereses" (interest-free); NULL means unknown.
  monthlyPrice       Float?                     // e.g. 40.58
  monthlyMonths      Int?                       // e.g. 24, 29, 36
  financingProvider  String?                    // "CaixaBank", "Cetelem", "Younited", "Smart Plan", "Amazon"
  monthlyApr         Float?                     // TAE %; 0.0 = interest-free, null = unknown

  scrapedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Lifecycle tracking (added 2026-06-18)
  // discontinued: scraper couldn't find this SKU on the store's search
  //               results in the last attempt. UI filters these out so
  //               stale prices don't pretend to be live offers.
  //               Flipped back to false automatically the moment the SKU
  //               reappears in a future scrape (no manual intervention).
  // lastSeenAt:   timestamp of the last scrape that DID find this SKU.
  //               Lets the next-cooldown logic decide between "first miss,
  //               retry tomorrow" (recently seen) vs "long miss, retry
  //               in a week" (gone for a while).
  // nextCheckAt:  earliest time the nightly cron should try this SKU
  //               again. NULL means "always try" (the normal state for
  //               actively-stocked SKUs). On a miss we set this to
  //               NOW()+1day on the first miss, NOW()+7days afterwards.
  //               Indexed because cron filters on it heavily.
  discontinued Boolean   @default(false)
  lastSeenAt   DateTime?
  nextCheckAt  DateTime?

  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([variantId, storeId])
  @@index([variantId])
  @@index([storeId])
  @@index([discountPct])
  @@index([discontinued])
  @@index([nextCheckAt])
}

/// Historical prices (daily snapshots)
model PriceHistory {
  id          Int       @id @default(autoincrement())
  variantId   Int
  storeId     String

  price       Float
  date        DateTime  @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([variantId, date])
  @@index([variantId, storeId, date])
}

// ============ MONETIZATION ============

/// Anonymous click tracking on affiliate links (GDPR-friendly: no user data)
model Click {
  id          Int      @id @default(autoincrement())
  variantId   Int?
  storeId     String

  source      String   @default("web")          // "web" | "email" | "push"
  userAgent   String?
  country     String?                            // from CF/Vercel header
  referer     String?

  createdAt   DateTime @default(now())

  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId])
  @@index([createdAt])
}

// ============ SCRAPER ============

model ScrapedProduct {
  id           Int      @id @default(autoincrement())
  sku          String
  storeId      String
  variantId    Int?                             // null until matched

  url          String
  name         String
  manufacturer String   @default("Apple")
  category     String

  price        Float    @default(0)
  oldprice     Float    @default(0)
  available    String   @default("")

  techs        String   @default("{}")
  images       String   @default("[]")

  ean          String?
  color        String   @default("")
  memory       String   @default("")
  display      String   @default("")
  cpu          String   @default("")

  matchStatus  String   @default("pending")     // "pending" | "matched" | "auto_created" | "ignored"
  matchScore   Float?

  scrapedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variant      ProductVariant?  @relation(fields: [variantId], references: [id])
  store        Store            @relation(fields: [storeId], references: [id])

  @@unique([sku, storeId])
  @@index([category])
  @@index([storeId])
  @@index([matchStatus])
  @@index([variantId])
}

model ScrapingLog {
  id          Int      @id @default(autoincrement())
  storeId     String
  category    String?
  status      String                             // "success" | "partial" | "failed"
  itemsFound  Int?
  itemsSaved  Int?
  error       String?
  duration    Int?
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

// ============ SECOND-HAND ============

model Listing {
  id          Int      @id @default(autoincrement())
  variantId   Int

  source      String   @default("manzana")     // "manzana" | "wallapop" | "milanuncios"
  sourceUrl   String?
  sourceId    String?

  precio      Float
  estado      String                             // "Excelente" | "Muy bueno" | "Bueno" | "Aceptable"
  ciudad      String
  vendedor    String
  descripcion String   @default("")
  fotos       String   @default("[]")

  latitude    Float?
  longitude   Float?

  active      Boolean  @default(true)
  views       Int      @default(0)

  // ── Contact (added 2026-06-25) ───────────────────────────────────
  // telefono is the seller's phone, captured at listing time. It is
  // NEVER returned by the public listings/products endpoints — the UI
  // calls POST /api/listings/[id]/phone-view to reveal it, which
  // returns the number AND bumps phoneViews. Keeping it private at
  // rest stops scrapers from sweeping numbers out of the public JSON
  // and lets us track real buyer intent instead of card impressions.
  //
  // phoneViews counts how many distinct users have clicked "show
  // phone". It's the conversion metric we surface on the card
  // ("X interesados") because phone reveal == real intent to contact,
  // whereas card impressions count idle scrolling.
  telefono    String?
  phoneViews  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([variantId])
  @@index([source])
  @@index([ciudad])
}

// ============ REVIEWS ============

model Review {
  id        Int      @id @default(autoincrement())
  productId Int

  fuente    String
  nota      Float
  texto     String
  url       String?
  fecha     String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

