
# Local scraper diagnostic logs
Scraper/*.log
Scraper/logs/

# Per-host scheduler scripts — carry a plaintext DATABASE_URL inline
# because they live only on the workstation that owns the corresponding
# Windows Task Scheduler entry. ECI and Fnac run here instead of the
# VPS because their anti-bot stacks block IONOS datacenter IPs.
Scraper/*-refresh.bat
Scraper/elcorte-refresh.bat
Scraper/fnac-refresh.bat
